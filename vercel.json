{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/prerender?page=home"
    },
    {
      "source": "/cars",
      "destination": "/api/prerender?page=cars"
    },
    {
      "source": "/make",
      "destination": "/api/prerender?page=makes"
    },
    {
      "source": "/make/:make",
      "destination": "/api/prerender?page=catalog-make&make=:make"
    },
    {
      "source": "/make/:make/:model",
      "destination": "/api/prerender?page=catalog-model&make=:make&model=:model"
    },
    {
      "source": "/make/:make/:model/:generation",
      "destination": "/api/prerender?page=catalog-generation&make=:make&model=:model&generation=:generation"
    },
    {
      "source": "/make/:make/:model/changes/:pair",
      "destination": "/api/prerender?page=catalog-changes&make=:make&model=:model&pair=:pair"
    },
    {
      "source": "/make/:make/:model/:generation/:variant",
      "destination": "/api/prerender?page=catalog-variant&make=:make&model=:model&generation=:generation&variant=:variant"
    },
    {
      "source": "/model_detail/:slug/",
      "destination": "/api/prerender?page=legacy&kind=model&slug=:slug"
    },
    {
      "source": "/model_detail/:slug",
      "destination": "/api/prerender?page=legacy&kind=model&slug=:slug"
    },
    {
      "source": "/manufacturer/:slug/",
      "destination": "/api/prerender?page=legacy&kind=make&slug=:slug"
    },
    {
      "source": "/manufacturer/:slug",
      "destination": "/api/prerender?page=legacy&kind=make&slug=:slug"
    },
    {
      "source": "/car_detail/:id/",
      "destination": "/api/prerender?page=legacy&kind=variant&slug=:id"
    },
    {
      "source": "/car_detail/:id",
      "destination": "/api/prerender?page=legacy&kind=variant&slug=:id"
    },
    {
      "source": "/compare",
      "destination": "/api/prerender?page=compare-index"
    },
    {
      "source": "/compare/:pair",
      "destination": "/api/prerender?page=compare&slug=:pair"
    },
    {
      "source": "/best",
      "destination": "/api/prerender?page=best-index"
    },
    {
      "source": "/best/:criteria",
      "destination": "/api/prerender?page=best&slug=:criteria"
    },
    {
      "source": "/compare-range/:path(.*)",
      "destination": "https://compare-range.vercel.app/:path"
    },
    {
      "source": "/what-is-ev-lineup",
      "destination": "/what-is-ev-lineup.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/alternatives",
      "destination": "/alternatives.html"
    },
    {
      "source": "/vs/edmunds",
      "destination": "/vs/edmunds.html"
    },
    {
      "source": "/vs/kelley-blue-book",
      "destination": "/vs/kelley-blue-book.html"
    },
    {
      "source": "/vs/car-and-driver",
      "destination": "/vs/car-and-driver.html"
    },
    {
      "source": "/vs/fueleconomy-gov",
      "destination": "/vs/fueleconomy-gov.html"
    },
    {
      "source": "/:file(.*\\.(?:txt|xml|json|ico|png|jpg|jpeg|webp|svg|js|css|map|woff|woff2))",
      "destination": "/api/notfound"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/compare-range",
      "destination": "/compare-range/",
      "permanent": false
    },
    {
      "source": "/make/:path*/",
      "destination": "/make/:path*",
      "permanent": true
    },
    {
      "source": "/cars/",
      "destination": "/cars",
      "permanent": true
    },
    {
      "source": "/compare/",
      "destination": "/compare",
      "permanent": true
    },
    {
      "source": "/compare/:pair/",
      "destination": "/compare/:pair",
      "permanent": true
    },
    {
      "source": "/best/",
      "destination": "/best",
      "permanent": true
    },
    {
      "source": "/best/:criteria/",
      "destination": "/best/:criteria",
      "permanent": true
    },
    {
      "source": "/what-is-ev-lineup/",
      "destination": "/what-is-ev-lineup",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/alternatives/",
      "destination": "/alternatives",
      "permanent": true
    },
    {
      "source": "/vs/:slug/",
      "destination": "/vs/:slug",
      "permanent": true
    },
    {
      "source": "/vs",
      "destination": "/alternatives",
      "permanent": false
    }
  ]
}

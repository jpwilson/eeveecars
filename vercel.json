{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/prerender?page=home"
    },
    {
      "source": "/model_detail/:slug",
      "destination": "/api/prerender?page=model&slug=:slug"
    },
    {
      "source": "/manufacturer/:slug",
      "destination": "/api/prerender?page=make&slug=:slug"
    },
    {
      "source": "/compare/:pair",
      "destination": "/api/prerender?page=compare&slug=:pair"
    },
    {
      "source": "/best/:criteria",
      "destination": "/api/prerender?page=best&slug=:criteria"
    },
    {
      "source": "/compare-range/:path(.*)",
      "destination": "https://compare-range.vercel.app/:path"
    },
    {
      "source": "/what-is-ev-lineup",
      "destination": "/what-is-ev-lineup.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/alternatives",
      "destination": "/alternatives.html"
    },
    {
      "source": "/vs/edmunds",
      "destination": "/vs/edmunds.html"
    },
    {
      "source": "/vs/kelley-blue-book",
      "destination": "/vs/kelley-blue-book.html"
    },
    {
      "source": "/vs/car-and-driver",
      "destination": "/vs/car-and-driver.html"
    },
    {
      "source": "/vs/fueleconomy-gov",
      "destination": "/vs/fueleconomy-gov.html"
    },
    {
      "source": "/:file(.*\\.(?:txt|xml|json|ico|png|jpg|jpeg|webp|svg|js|css|map|woff|woff2))",
      "destination": "/api/notfound"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/compare-range",
      "destination": "/compare-range/",
      "permanent": false
    },
    {
      "source": "/what-is-ev-lineup/",
      "destination": "/what-is-ev-lineup",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/alternatives/",
      "destination": "/alternatives",
      "permanent": true
    },
    {
      "source": "/vs/:slug/",
      "destination": "/vs/:slug",
      "permanent": true
    },
    {
      "source": "/vs",
      "destination": "/alternatives",
      "permanent": false
    }
  ]
}

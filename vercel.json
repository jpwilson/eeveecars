{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://ev-backend-three.vercel.app/sitemap.xml"
    },
    { "source": "/", "destination": "/api/prerender?page=home" },
    {
      "source": "/model_detail/:slug",
      "destination": "/api/prerender?page=model&slug=:slug"
    },
    {
      "source": "/manufacturer/:slug",
      "destination": "/api/prerender?page=make&slug=:slug"
    },
    {
      "source": "/compare/:pair",
      "destination": "/api/prerender?page=compare&slug=:pair"
    },
    {
      "source": "/best/:criteria",
      "destination": "/api/prerender?page=best&slug=:criteria"
    },
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
